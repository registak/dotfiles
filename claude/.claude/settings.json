{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-fable-5",
  "effortLevel": "xhigh",
  "language": "日本語",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "mcp__notion__notion-fetch",
      "mcp__notion__notion-search",
      "mcp__notion__notion-query-meeting-notes",
      "mcp__notion__notion-query-database-view",
      "mcp__slack__slack_search_public_and_private",
      "mcp__slack__slack_search_channels",
      "mcp__slack__slack_search_users",
      "mcp__slack__slack_read_channel",
      "mcp__slack__slack_read_thread",
      "mcp__slack__slack_read_user_profile",
      "mcp__slack__slack_read_canvas"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "remoteControlAtStartup": true,
  "tui": "fullscreen",
  "agentPushNotifEnabled": true
}
